export VISUAL=nvim
export EDITOR=$VISUAL
export PAGER=less
export MANPAGER=less

export GOPATH="$PROJECTS/.go"
export GOMODCACHE="$GOPATH/pkg/mod"
export GOCACHE="$GOPATH/cache/build"
export GOBIN="$GOPATH/bin"
[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
export DO_NOT_TRACK=true

export NVM_DIR="$HOME/.nvm"
if [ -d "$NVM_DIR" ]; then
    NODE_BIN_DIR=""
    if [ -s "$NVM_DIR/alias/default" ]; then
        DEFAULT_VERSION=$(cat "$NVM_DIR/alias/default")
        for dir in "$NVM_DIR/versions/node/v${DEFAULT_VERSION}"* "$NVM_DIR/versions/node/${DEFAULT_VERSION}"*; do
            if [ -d "$dir/bin" ]; then
                NODE_BIN_DIR="$dir/bin"
                break
            fi
        done
    fi
    if [ -z "$NODE_BIN_DIR" ]; then
        for dir in "$NVM_DIR/versions/node"/*; do
            if [ -d "$dir/bin" ]; then
                NODE_BIN_DIR="$dir/bin"
                break
            fi
        done
    fi
    if [ -n "$NODE_BIN_DIR" ]; then
        export PATH="$NODE_BIN_DIR:$PATH"
    fi
fi

export PATH="$HOME/.local/bin:$GOBIN:$PATH"
[[ $- != *i* ]] && return

export GPG_TTY=$(tty 2>/dev/null)
set -o emacs

export HISTCONTROL=ignoreboth
export HISTSIZE=10000
export HISTFILESIZE=20000
shopt -s histappend
PROMPT_COMMAND="history -a${PROMPT_COMMAND:+; $PROMPT_COMMAND}"

alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'
alias rm='rm -v'
alias cp='cp -v'
alias mv='mv -v'
alias ls='ls --color=auto'
alias ll='ls -lh --color=auto'
alias la='ls -a --color=auto'
alias lla='ls -lah --color=auto'

if [[ $- == *i* ]]; then
    bind "set completion-ignore-case on"

    if command -v fzf >/dev/null; then
        export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --highlight-line --info=inline --prompt='> '"
        export FZF_CTRL_T_COMMAND="fd --type f --type d --hidden --follow --exclude .git"
        export FZF_CTRL_T_OPTS="--preview 'test -d {} && ls --color=always {} || cat {}' --preview-window=right,60%,border-left"
        export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git"
        export FZF_ALT_C_OPTS="--preview 'ls --color=always {}' --preview-window=right,60%,border-left"

        [ -f /usr/share/fzf/key-bindings.bash ] && . /usr/share/fzf/key-bindings.bash
        [ -f /usr/share/fzf/completion.bash ] && . /usr/share/fzf/completion.bash
    fi

    export PS1='[\u@\[\e[38;2;255;50;50m\]\h\[\e[0m\] \W]\$ '

    if command -v yazi >/dev/null; then
        yy() {
            local tmp="$(mktemp -t yazi-cwd.XXXXXX)"
            yazi "$@" --cwd-file="$tmp"
            if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
                cd -- "$cwd"
            fi
            rm -f -- "$tmp"
        }
    fi

    if command -v zoxide >/dev/null; then
        eval "$(zoxide init bash)"
    fi
fi

_lazy_load_nvm() {
    unset -f nvm
    [ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
    [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
}
nvm() { _lazy_load_nvm; nvm "$@"; }

[ -r /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion
