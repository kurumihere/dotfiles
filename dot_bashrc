[[ $- != *i* ]] && return

export VISUAL=emacs
export EDITOR=$VISUAL
export PAGER=less
export MANPAGER=less

export PROJECTS="$HOME/Projects"
export GOPATH="$PROJECTS/.go"
export GOMODCACHE="$GOPATH/pkg/mod"
export GOCACHE="$GOPATH/cache/build"
export GOBIN="$GOPATH/bin"

export DOCKER_SCAN_SUGGEST=false
export DOTNET_CLI_TELEMETRY_OPTOUT=true
export DO_NOT_TRACK=true

set -o emacs

export PATH="$HOME/.local/bin:$GOBIN:$PATH"

export HISTCONTROL=ignoreboth
export HISTSIZE=10000
export HISTFILESIZE=20000
shopt -s histappend
export PROMPT_COMMAND="history -a; $PROMPT_COMMAND"

alias grep='grep --color=auto'
alias diff='diff --color=auto'
alias ip='ip -color=auto'
alias rm='rm -i'
alias cp='cp -i'
alias mv='mv -i'

if [[ $- == *i* ]]; then
    bind "set completion-ignore-case on"

    if command -v fzf >/dev/null; then
        export FZF_DEFAULT_OPTS="--height 40% --layout=reverse --border --highlight-line --info=inline --prompt='> '"
        export FZF_CTRL_T_COMMAND="fd --type f --type d --hidden --follow --exclude .git"
        export FZF_CTRL_T_OPTS="--preview 'test -d {} && eza --tree --level=2 --color=always {} || bat --style=numbers --color=always --line-range=:200 {}' --preview-window=right,60%,border-left"
        export FZF_ALT_C_COMMAND="fd --type d --hidden --follow --exclude .git"
        export FZF_ALT_C_OPTS="--preview 'eza --tree --level=2 --color=always {}' --preview-window=right,60%,border-left"
        
        [ -f /usr/share/fzf/key-bindings.bash ] && . /usr/share/fzf/key-bindings.bash
        [ -f /usr/share/fzf/completion.bash ] && . /usr/share/fzf/completion.bash
    fi

    parse_git_branch() {
        git branch 2>/dev/null | sed -e '/^[^*]/d' -e 's/* \(.*\)/ (\1)/'
    }
    export PS1="\u@\[\033[01;38;2;251;115;133m\]\h\[\033[00m\]:\w\[\033[38;2;92;99;112m\]\$(parse_git_branch)\[\033[00m\]\$ "

    if command -v eza >/dev/null; then
        alias ls='eza --group-directories-first'
        alias ll='eza --group-directories-first --long --git'
        alias la='eza --group-directories-first --long --all --git'
    else
        alias ls='ls --color=auto'
        alias ll='ls -lh --color=auto'
        alias la='ls -a --color=auto'
        alias lla='ls -lah --color=auto'
    fi

    if command -v bat >/dev/null; then
        alias cat='bat --style=plain --paging=never'
    fi

    if command -v yazi >/dev/null; then
        yy() {
            local tmp="$(mktemp -t yazi-cwd.XXXXXX)"
            yazi "$@" --cwd-file="$tmp"
            if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
                cd -- "$cwd"
            fi
            rm -f -- "$tmp"
        }
    fi

    if command -v zoxide >/dev/null; then
        eval "$(zoxide init bash)"
    fi
fi

export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

[ -r /usr/share/bash-completion/bash_completion ] && . /usr/share/bash-completion/bash_completion

export GPG_TTY=$(tty)
