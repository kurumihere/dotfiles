set $mod Mod4
set $terminal alacritty

font pango:JetBrainsMono Nerd Font 10
include /home/kurumi/.config/i3/theme.conf

# Session
exec --no-startup-id xrandr --dpi 96
exec --no-startup-id xrdb -merge /home/kurumi/.Xresources
exec --no-startup-id /home/kurumi/.local/bin/theme-switch auto
exec --no-startup-id /home/kurumi/.fehbg
exec --no-startup-id xss-lock --transfer-sleep-lock -- i3lock -n -e -i /home/kurumi/Pictures/Wallpapers/k-on.png.jpg
exec --no-startup-id setxkbmap -layout us,ru -option grp:alt_shift_toggle
exec --no-startup-id systemctl --user import-environment DISPLAY XAUTHORITY I3SOCK XDG_CURRENT_DESKTOP GTK_USE_PORTAL QT_QPA_PLATFORMTHEME
exec --no-startup-id dbus-update-activation-environment --systemd DISPLAY XAUTHORITY I3SOCK XDG_CURRENT_DESKTOP GTK_USE_PORTAL QT_QPA_PLATFORMTHEME

# Services
exec --no-startup-id systemctl --user start xsettingsd.service
exec --no-startup-id systemctl --user start xdg-desktop-portal.service
exec --no-startup-id systemctl --user start picom.service
exec --no-startup-id dunst
exec_always --no-startup-id /home/kurumi/.config/polybar/launch.sh

# Appearance
for_window [class=".*"] border pixel 1
floating_modifier $mod
gaps inner 2
gaps outer 2
smart_gaps off
focus_follows_mouse yes

# Launchers
bindsym $mod+Return exec --no-startup-id env -u NO_COLOR $terminal
bindsym $mod+Shift+Return exec --no-startup-id env -u NO_COLOR $terminal --command tmux new-session -A -s main
bindsym $mod+d exec --no-startup-id rofi -show drun
bindsym $mod+z exec --no-startup-id /home/kurumi/.config/i3/sc.sh
bindsym $mod+Shift+t exec --no-startup-id /home/kurumi/.local/bin/theme-switch toggle
bindsym $mod+x exec --no-startup-id i3lock -n -e -i /home/kurumi/Pictures/Wallpapers/umineko-wallpaper.png
bindsym XF86ScreenSaver exec --no-startup-id i3lock -n -e -i /home/kurumi/Pictures/Wallpapers/umineko-wallpaper.jpg

# Window focus
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right

# Window movement
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Layout
bindsym $mod+q kill
bindsym $mod+v split v
bindsym $mod+f fullscreen toggle
bindsym $mod+s layout stacking
bindsym $mod+w layout tabbed
bindsym $mod+e layout toggle split
bindsym $mod+Shift+f floating toggle
bindsym $mod+space focus mode_toggle
bindsym $mod+a focus parent

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# i3 controls
bindsym $mod+Shift+c reload
bindsym $mod+Shift+r restart
bindsym $mod+Shift+e exec "i3-nagbar -t warning -m 'Exit i3?' -B 'Exit' 'i3-msg exit'"

mode "resize" {
    bindsym h resize shrink width 10 px or 10 ppt
    bindsym j resize grow height 10 px or 10 ppt
    bindsym k resize shrink height 10 px or 10 ppt
    bindsym l resize grow width 10 px or 10 ppt

    bindsym Return mode "default"
    bindsym Escape mode "default"
    bindsym $mod+r mode "default"
}

bindsym $mod+r mode "resize"
