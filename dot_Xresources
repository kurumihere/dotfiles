Xft.dpi: 96
Xft.antialias: 1
Xft.hinting: 1
Xft.hintstyle: hintslight
Xft.rgba: rgb
Xft.lcdfilter: lcddefault

xterm*renderFont: true
xterm*faceName: JetBrainsMono Nerd Font
xterm*faceSize: 10
xterm*selectToClipboard: true
xterm*VT100*translations: #override \n\
    Shift Ctrl <Key> C: copy-selection(CLIPBOARD) \n\
    Shift Ctrl <Key> V: insert-selection(CLIPBOARD)

URxvt*font: xft:JetBrainsMono Nerd Font:size=10
URxvt*boldFont: xft:JetBrainsMono Nerd Font:bold:size=10
st*font: JetBrainsMono Nerd Font:size=10
*font: xft:JetBrainsMono Nerd Font:size=10

xterm*background: #20202a
xterm*foreground: #abb2bf
xterm*cursorColor: #dedede
