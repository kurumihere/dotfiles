#
# ~/.bash_profile
#
export PATH="$HOME/.local/bin:$PATH"

export XDG_CONFIG_HOME="$HOME/.config"
export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_STATE_HOME="$HOME/.local/state"

export RUSTUP_HOME="$XDG_DATA_HOME/rustup"
export CARGO_HOME="$XDG_DATA_HOME/cargo"
export NPM_CONFIG_USERCONFIG="$XDG_CONFIG_HOME/npm/npmrc"
export NVM_DIR="$XDG_DATA_HOME/nvm"
export GTK2_RC_FILES="$XDG_CONFIG_HOME/gtk-2.0/gtkrc"
export GNUPGHOME="$XDG_DATA_HOME/gnupg"

[ -d "$CARGO_HOME/bin" ] && export PATH="$CARGO_HOME/bin:$PATH"

export EDITOR="nvim"
export VISUAL="nvim"
export QT_QPA_PLATFORMTHEME="qt6ct"
export QT_STYLE_OVERRIDE="Fusion"

[[ -f ~/.bashrc ]] && . ~/.bashrc

if [[ -z $NIRI_AUTOSTART && -z $WAYLAND_DISPLAY && -z $DISPLAY && $(tty) == /dev/tty1 ]] &&
   ! systemctl --user --quiet is-active niri.service; then
    mkdir -p "$HOME/.local/state"
    if ! NIRI_AUTOSTART=1 niri-session >"$HOME/.local/state/niri-session.log" 2>&1; then
        printf 'Niri failed to start. See %s\n' "$HOME/.local/state/niri-session.log"
    fi
fi
