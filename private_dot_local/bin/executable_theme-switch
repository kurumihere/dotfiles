#!/usr/bin/env bash
set -euo pipefail

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/theme-switch"
CONFIG_FILE="$CONFIG_DIR/config"
STATE_FILE="$CONFIG_DIR/current"
SYSTEMD_USER_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"

LIGHT_TIME="${LIGHT_TIME:-08:00}"
DARK_TIME="${DARK_TIME:-20:00}"
LATITUDE="${LATITUDE:-55.4443}"
LONGITUDE="${LONGITUDE:-65.3161}"
SUN_ZENITH="${SUN_ZENITH:-90.833}"
AUTO_CHECK_INTERVAL="${AUTO_CHECK_INTERVAL:-10min}"

mkdir -p "$CONFIG_DIR" "$SYSTEMD_USER_DIR"

if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck source=/dev/null
  source "$CONFIG_FILE"
fi

usage() {
  cat >&2 <<'EOF'
Usage: theme-switch light|dark|toggle|auto|refresh|status|--install-timers
EOF
}

write_file() {
  local path="$1"
  local tmp

  install -d "$(dirname "$path")"
  tmp="$(mktemp)"
  cat >"$tmp"
  install -m 0644 "$tmp" "$path"
  rm -f "$tmp"
}

run_quiet() {
  "$@" >/dev/null 2>&1 || true
}

current_theme() {
  if [[ -f "$STATE_FILE" ]]; then
    cat "$STATE_FILE"
  else
    echo dark
  fi
}

load_palette() {
  case "$1" in
    light)
      bg="#F5F6FA"
      polybar_bg="#CCF5F6FA"
      bg_alt="#E7E9F2"
      fg="#20202A"
      muted="#6F6B84"
      disabled="#9B97AD"
      accent="#7A4DA3"
      accent_alt="#8A62B3"
      selected="#6C5CE7"
      urgent="#C72C52"
      blue="#315FBD"
      green="#1F8A55"
      yellow="#A38A00"
      cyan="#238C8C"
      cursor="#20202A"
      bright_red="#A82443"
      bright_green="#187343"
      bright_yellow="#7A6500"
      bright_blue="#244D9A"
      bright_magenta="#65418A"
      bright_cyan="#1B7070"
      bright_white="#20202A"
      gtk_theme="Adwaita"
      gtk_dark=0
      ;;
    dark)
      bg="#2C2C3B"
      polybar_bg="#CC2C2C3B"
      bg_alt="#343445"
      fg="#D0D0D9"
      muted="#8985A1"
      disabled="#646078"
      accent="#713A91"
      accent_alt="#814F9E"
      selected="#8A7CF8"
      urgent="#DD3962"
      blue="#598BFF"
      green="#239E62"
      yellow="#CABA2D"
      cyan="#43A6A6"
      cursor="#FFFFFF"
      bright_red="#F98B9E"
      bright_green="#4BC77F"
      bright_yellow="#E0D15E"
      bright_blue="#7094FF"
      bright_magenta="#9E71E0"
      bright_cyan="#6CD0D0"
      bright_white="#F5F6FA"
      gtk_theme="Adwaita-dark"
      gtk_dark=1
      ;;
    *)
      usage
      exit 2
      ;;
  esac
}

write_i3() {
  write_file "$HOME/.config/i3/theme.conf" <<EOF
set \$bg $bg
set \$bg_alt $bg_alt
set \$fg $fg
set \$muted $disabled
set \$accent $accent
set \$accent_border $accent_alt
set \$urgent $urgent

client.focused          \$muted \$bg_alt \$fg    \$accent \$muted
client.focused_inactive \$bg    \$bg_alt \$muted \$bg     \$bg
client.unfocused        \$bg    \$bg     \$muted \$bg     \$bg
client.urgent           \$urgent \$urgent        \$fg    \$urgent \$fg
client.placeholder      \$bg     \$bg            \$muted \$bg     \$bg
EOF
}

write_polybar() {
  write_file "$HOME/.config/polybar/colors.ini" <<EOF
[colors]
background = $polybar_bg
foreground = $fg
muted = $muted
disabled = $disabled

accent = $accent
accent-alt = $accent_alt
blue = $blue
urgent = $urgent
EOF
}

write_rofi() {
  write_file "$HOME/.config/rofi/current-theme.rasi" <<EOF
* {
    background: $bg;
    background-alt: $bg_alt;
    foreground: $fg;
    muted: $disabled;
    border: $accent_alt;
    selected: $selected;
    urgent: $urgent;

    background-color: @background;
    text-color: @foreground;
    font: "JetBrainsMono Nerd Font 10";
}

window {
    width: 360px;
    border: 1px;
    border-color: @border;
}

mainbox {
    padding: 6px;
}

element {
    padding: 4px 6px;
}

inputbar {
    background-color: @background-alt;
}

entry {
    placeholder-color: @muted;
}

element selected {
    background-color: transparent;
    text-color: @foreground;
    border: 1px;
    border-color: @selected;
}

element urgent {
    text-color: @urgent;
}
EOF
}

write_alacritty() {
  write_file "$HOME/.alacritty.toml" <<EOF
[general]
live_config_reload = true
ipc_socket = true

[env]
TERM = "alacritty"

[window]
decorations = "None"
dynamic_title = true
opacity = 0.8

[font]
size = 10.0
normal = { family = "JetBrainsMono Nerd Font", style = "Regular" }
bold = { family = "JetBrainsMono Nerd Font", style = "Bold" }
italic = { family = "JetBrainsMono Nerd Font", style = "Italic" }

[cursor]
style = { shape = "Block", blinking = "Never" }

[mouse]
hide_when_typing = true

[scrolling]
history = 10000
multiplier = 3

[colors.primary]
background = "$bg"
foreground = "$fg"

[colors.cursor]
text = "$bg"
cursor = "$cursor"

[colors.selection]
text = "$fg"
background = "$accent"

[colors.normal]
black = "$bg"
red = "$urgent"
green = "$green"
yellow = "$yellow"
blue = "$blue"
magenta = "$accent"
cyan = "$cyan"
white = "$fg"

[colors.bright]
black = "$disabled"
red = "$bright_red"
green = "$bright_green"
yellow = "$bright_yellow"
blue = "$bright_blue"
magenta = "$bright_magenta"
cyan = "$bright_cyan"
white = "$bright_white"
EOF
}

write_gtk() {
  write_file "$HOME/.xsettingsd" <<EOF
Net/ThemeName "$gtk_theme"
Net/IconThemeName "Adwaita"
Net/EnableEventSounds 0
Net/EnableInputFeedbackSounds 0

Gtk/ThemeName "$gtk_theme"
Gtk/IconThemeName "Adwaita"
Gtk/CursorThemeName "Adwaita"
Gtk/CursorThemeSize 24
Gtk/FontName "Noto Sans 10"
Gtk/MonospaceFontName "JetBrainsMono Nerd Font 10"
Gtk/ApplicationPreferDarkTheme $gtk_dark
Gtk/EnableAnimations 1
Gtk/ToolbarStyle "icons"
Gtk/MenuImages 1
Gtk/ButtonImages 0
Gtk/PrimaryButtonWarpsSlider 0

Xft/DPI 98304
Xft/Antialias 1
Xft/Hinting 1
Xft/HintStyle "hintslight"
Xft/RGBA "rgb"
Xft/lcdfilter "lcddefault"
EOF

  for gtk_dir in "$HOME/.config/gtk-3.0" "$HOME/.config/gtk-4.0"; do
    write_file "$gtk_dir/settings.ini" <<EOF
[Settings]
gtk-theme-name=$gtk_theme
gtk-icon-theme-name=Adwaita
gtk-cursor-theme-name=Adwaita
gtk-cursor-theme-size=24
gtk-font-name=Noto Sans 10
gtk-application-prefer-dark-theme=$gtk_dark
EOF
  done
}

write_dunst() {
  write_file "$HOME/.config/dunst/dunstrc" <<EOF
[global]
    monitor = 0
    follow = keyboard
    origin = top-right
    offset = (10, 44)
    width = 320
    height = (0, 220)
    notification_limit = 5

    font = JetBrainsMono Nerd Font 10
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    ellipsize = middle
    show_age_threshold = 60
    stack_duplicates = true
    hide_duplicate_count = false

    padding = 8
    horizontal_padding = 10
    text_icon_padding = 8
    separator_height = 1
    separator_color = frame
    frame_width = 1
    frame_color = "$accent_alt"
    gap_size = 4
    corner_radius = 0
    transparency = 20

    icon_theme = Adwaita
    enable_recursive_icon_lookup = true
    min_icon_size = 24
    max_icon_size = 32
    icon_corner_radius = 0

    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 120
    progress_bar_max_width = 280
    progress_bar_corner_radius = 0

    idle_threshold = 120
    show_indicators = yes
    history_length = 20
    browser = xdg-open

    dmenu = rofi -dmenu -p dunst

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "$bg"
    foreground = "$muted"
    highlight = "$accent"
    timeout = 4

[urgency_normal]
    background = "$bg"
    foreground = "$fg"
    highlight = "$accent"
    timeout = 6

[urgency_critical]
    background = "$bg"
    foreground = "$fg"
    frame_color = "$urgent"
    highlight = "$urgent"
    timeout = 0
EOF
}

write_vim() {
  local vim_background

  if [[ "$1" == dark ]]; then
    vim_background="dark"
  else
    vim_background="light"
  fi

  write_file "$HOME/.vim/theme.vim" <<EOF
" Generated by theme-switch. Edit ~/.local/bin/theme-switch instead.
set background=$vim_background
EOF
}

apply_alacritty_runtime() {
  local args
  local runtime_dir
  local socket

  command -v alacritty >/dev/null 2>&1 || return 0

  args=(
    "colors.primary.background='$bg'"
    "colors.primary.foreground='$fg'"
    "colors.cursor.text='$bg'"
    "colors.cursor.cursor='$cursor'"
    "colors.selection.text='$fg'"
    "colors.selection.background='$accent'"
    "colors.normal.black='$bg'"
    "colors.normal.red='$urgent'"
    "colors.normal.green='$green'"
    "colors.normal.yellow='$yellow'"
    "colors.normal.blue='$blue'"
    "colors.normal.magenta='$accent'"
    "colors.normal.cyan='$cyan'"
    "colors.normal.white='$fg'"
    "colors.bright.black='$disabled'"
    "colors.bright.red='$bright_red'"
    "colors.bright.green='$bright_green'"
    "colors.bright.yellow='$bright_yellow'"
    "colors.bright.blue='$bright_blue'"
    "colors.bright.magenta='$bright_magenta'"
    "colors.bright.cyan='$bright_cyan'"
    "colors.bright.white='$bright_white'"
  )

  run_quiet alacritty msg config -w -1 "${args[@]}"

  runtime_dir="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  for socket in "$runtime_dir"/Alacritty-*.sock /tmp/Alacritty-*.sock; do
    [[ -S "$socket" ]] || continue
    run_quiet alacritty msg --socket "$socket" config -w -1 "${args[@]}"
  done
}

apply_gsettings() {
  command -v gsettings >/dev/null 2>&1 || return 0

  if [[ "$1" == dark ]]; then
    run_quiet gsettings set org.gnome.desktop.interface color-scheme prefer-dark
  else
    run_quiet gsettings set org.gnome.desktop.interface color-scheme prefer-light
  fi
  run_quiet gsettings set org.gnome.desktop.interface gtk-theme "$gtk_theme"
}

reload_polybar() {
  local launcher="$HOME/.config/polybar/launch.sh"

  [[ -x "$launcher" ]] || return 0

  if command -v i3-msg >/dev/null 2>&1; then
    i3-msg "exec --no-startup-id $launcher" >/dev/null 2>&1 && return 0
  fi

  run_quiet "$launcher"
}

reload_desktop() {
  run_quiet xrdb -merge "$HOME/.Xresources"

  if systemctl --user --quiet is-active xsettingsd.service >/dev/null 2>&1; then
    run_quiet systemctl --user restart xsettingsd.service
  fi

  run_quiet pkill -x dunst
  run_quiet setsid -f dunst
  if command -v i3-msg >/dev/null 2>&1; then
    run_quiet i3-msg reload
  else
    reload_polybar
  fi

  apply_alacritty_runtime
  run_quiet tmux source-file "$HOME/.tmux.conf"
  run_quiet tmux refresh-client -S
}

apply_theme() {
  local theme="$1"
  local force="${2:-}"

  if [[ -z "$force" && "$theme" == "$(current_theme)" ]]; then
    return 0
  fi

  load_palette "$theme"
  write_i3
  write_polybar
  write_rofi
  write_alacritty
  write_gtk
  write_dunst
  write_vim "$theme"
  apply_gsettings "$theme"
  echo "$theme" >"$STATE_FILE"
  reload_desktop
}

install_timers() {
  write_file "$SYSTEMD_USER_DIR/theme-auto.service" <<EOF
[Unit]
Description=Switch desktop theme by sunrise and sunset

[Service]
Type=oneshot
Environment=DISPLAY=:0
Environment=XAUTHORITY=$HOME/.Xauthority
ExecStart=$HOME/.local/bin/theme-switch auto
EOF

  write_file "$SYSTEMD_USER_DIR/theme-auto.timer" <<EOF
[Unit]
Description=Check desktop theme by sunrise and sunset

[Timer]
OnBootSec=2min
OnUnitActiveSec=$AUTO_CHECK_INTERVAL
Persistent=true
Unit=theme-auto.service

[Install]
WantedBy=timers.target
EOF

  run_quiet systemctl --user daemon-reload
  run_quiet systemctl --user disable --now theme-light.timer theme-dark.timer
  run_quiet systemctl --user enable --now theme-auto.timer
}

sun_time() {
  local event="$1"

  awk -v event="$event" \
      -v lat="$LATITUDE" \
      -v lng="$LONGITUDE" \
      -v zenith="$SUN_ZENITH" \
      -v year="$(date +%Y)" \
      -v month="$(date +%-m)" \
      -v day="$(date +%-d)" \
      -v offset="$(date +%z)" '
    function deg2rad(v) { return v * atan2(0, -1) / 180 }
    function rad2deg(v) { return v * 180 / atan2(0, -1) }
    function norm360(v) { while (v < 0) v += 360; while (v >= 360) v -= 360; return v }
    function norm24(v) { while (v < 0) v += 24; while (v >= 24) v -= 24; return v }
    function day_of_year(y, m, d,    days, i) {
      split("31 28 31 30 31 30 31 31 30 31 30 31", days, " ")
      if ((y % 4 == 0 && y % 100 != 0) || y % 400 == 0) days[2] = 29
      for (i = 1; i < m; i++) d += days[i]
      return d
    }
    BEGIN {
      n = day_of_year(year, month, day)
      lng_hour = lng / 15
      approx = n + (((event == "sunrise" ? 6 : 18) - lng_hour) / 24)
      mean_anomaly = (0.9856 * approx) - 3.289
      true_long = norm360(mean_anomaly + (1.916 * sin(deg2rad(mean_anomaly))) + (0.020 * sin(deg2rad(2 * mean_anomaly))) + 282.634)
      right_ascension = norm360(rad2deg(atan2(0.91764 * (sin(deg2rad(true_long)) / cos(deg2rad(true_long))), 1)))
      right_ascension += (int(true_long / 90) * 90) - (int(right_ascension / 90) * 90)
      right_ascension /= 15
      sin_dec = 0.39782 * sin(deg2rad(true_long))
      cos_dec = cos(atan2(sin_dec, sqrt(1 - sin_dec * sin_dec)))
      cos_hour_angle = (cos(deg2rad(zenith)) - (sin_dec * sin(deg2rad(lat)))) / (cos_dec * cos(deg2rad(lat)))

      if (cos_hour_angle > 1 || cos_hour_angle < -1) exit 1

      if (event == "sunrise") {
        hour_angle = 360 - rad2deg(atan2(sqrt(1 - cos_hour_angle * cos_hour_angle), cos_hour_angle))
      } else {
        hour_angle = rad2deg(atan2(sqrt(1 - cos_hour_angle * cos_hour_angle), cos_hour_angle))
      }

      local_time = norm24((hour_angle / 15) + right_ascension - (0.06571 * approx) - 6.622 - lng_hour)
      sign = substr(offset, 1, 1) == "-" ? -1 : 1
      tz = sign * (substr(offset, 2, 2) + (substr(offset, 4, 2) / 60))
      local_time = norm24(local_time + tz)
      printf "%02d:%02d\n", int(local_time), int((local_time - int(local_time)) * 60 + 0.5)
    }'
}

theme_times() {
  local sunrise sunset

  sunrise="$(sun_time sunrise)" || sunrise="$LIGHT_TIME"
  sunset="$(sun_time sunset)" || sunset="$DARK_TIME"

  printf '%s %s\n' "$sunrise" "$sunset"
}

auto_theme() {
  local now sunrise sunset
  now="$(date +%H:%M)"
  read -r sunrise sunset < <(theme_times)

  if [[ "$sunrise" < "$sunset" ]]; then
    [[ "$now" > "$sunrise" && "$now" < "$sunset" ]] && echo light || echo dark
  else
    [[ "$now" > "$sunrise" || "$now" < "$sunset" ]] && echo light || echo dark
  fi
}

case "${1:-status}" in
  light|dark)
    apply_theme "$1"
    ;;
  toggle)
    if [[ "$(current_theme)" == dark ]]; then
      apply_theme light
    else
      apply_theme dark
    fi
    ;;
  auto)
    apply_theme "$(auto_theme)"
    ;;
  refresh)
    apply_theme "$(current_theme)" force
    ;;
  status)
    read -r sunrise sunset < <(theme_times)
    echo "theme=$(current_theme)"
    echo "LATITUDE=$LATITUDE"
    echo "LONGITUDE=$LONGITUDE"
    echo "sunrise=$sunrise"
    echo "sunset=$sunset"
    echo "auto_theme=$(auto_theme)"
    ;;
  --install-timers|install-timers)
    install_timers
    ;;
  *)
    usage
    exit 2
    ;;
esac
